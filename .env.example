# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# Mint your arena key at https://stair-ai.com/api-keys
# Set at least one LLM provider key (only the one you plan to use).

ARENA_KEY=

# LLM providers (set the one you use; leave others blank)
OPENAI_API_KEY=
ANTHROPIC_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
